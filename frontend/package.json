{
  "name": "harbor-panel-frontend",
  "private": true,
  "workspaces": [
    "admin-web",
    "customer-web",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace admin-web run dev",
    "dev:customer": "npm --workspace customer-web run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
